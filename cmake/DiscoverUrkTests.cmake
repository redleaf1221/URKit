# Build-time helper for tests/CMakeLists.txt.
#
# urk_tests registers its cases at load time, so CTest cannot see them at
# configure time. After each link this script asks the binary for its list and
# rewrites the include file CTest loads (TEST_INCLUDE_FILES), giving one CTest
# test per case. A case name is unique across the whole executable.
if (NOT DEFINED URK_TEST_EXECUTABLE)
    message(FATAL_ERROR "DiscoverUrkTests.cmake: URK_TEST_EXECUTABLE is not set")
endif()
if (NOT DEFINED URK_TEST_REGISTRATIONS)
    message(FATAL_ERROR "DiscoverUrkTests.cmake: URK_TEST_REGISTRATIONS is not set")
endif()

execute_process(
    COMMAND "${URK_TEST_EXECUTABLE}" --list
    OUTPUT_VARIABLE listing
    ERROR_VARIABLE listing_error
    RESULT_VARIABLE listing_result
    OUTPUT_STRIP_TRAILING_WHITESPACE
)
if (NOT listing_result EQUAL 0)
    message(FATAL_ERROR "DiscoverUrkTests.cmake: 'urk_tests --list' failed (${listing_result}): ${listing_error}")
endif()

string(REPLACE "\r" "" listing "${listing}")
string(REPLACE "\n" ";" cases "${listing}")

set(content "# Generated by cmake/DiscoverUrkTests.cmake from 'urk_tests --list'. Do not edit.\n")
set(properties "LABELS \"unit\" TIMEOUT 60")
if (URK_TEST_PROFILE_RAW)
    # One profile per process: %p keeps parallel cases from sharing a file.
    string(APPEND properties " ENVIRONMENT \"LLVM_PROFILE_FILE=${URK_TEST_PROFILE_RAW}\"")
endif()

set(registered 0)
foreach(case IN LISTS cases)
    if (case STREQUAL "")
        continue()
    endif()
    # CTest parses this file itself, and only the legacy `add_test(<name>
    # <command> <arg>...)` form is understood there: the modern
    # `add_test(NAME ... COMMAND ...)` spelling silently registers a test called
    # "NAME" with "COMMAND" as its executable.
    string(APPEND content
        "add_test(\"urk_tests.${case}\" \"${URK_TEST_EXECUTABLE}\" \"${case}\")\n")
    string(APPEND content
        "set_tests_properties(\"urk_tests.${case}\" PROPERTIES ${properties})\n")
    math(EXPR registered "${registered} + 1")
endforeach()

if (registered EQUAL 0)
    message(FATAL_ERROR "DiscoverUrkTests.cmake: the binary listed no cases")
endif()

file(WRITE "${URK_TEST_REGISTRATIONS}" "${content}")
message(STATUS "urk_tests: ${registered} case(s) registered with CTest")
